{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.mjs",
      "biome.json",
      "vite.config.ts",
      "tsconfig.json",
      "package.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/benchmark-continuous-stamp.mjs",
        "scripts/benchmark-continuous-stamps.mjs",
        "scripts/benchmark-move-large.mjs",
        "scripts/benchmark-move-preview.mjs",
        "scripts/benchmark-turntable.mjs",
        "tests/advanced-layers.test.mjs",
        "tests/clay-steady.test.mjs",
        "tests/expandable-editing.test.mjs",
        "tests/headset-tools-feedback.test.mjs",
        "tests/lighting.test.mjs",
        "tests/move-precision-input.test.mjs",
        "tests/move-preview.test.mjs",
        "tests/reference-images.test.mjs",
        "tests/shape-library.test.mjs",
        "tests/turntable.test.mjs",
        "tests/xr-brush-sizing.test.mjs",
        "tests/xr-layer-selection.test.mjs",
        "tests/xr-menus.test.mjs",
        "tests/xr-shape-stamp.test.mjs",
        "tests/xr-support-shortcuts.test.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    }
  ]
}
