{
  "name": "sdf-sculpt-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:https": "node scripts/dev-https.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/test.mjs",
    "test:quick": "node scripts/test.mjs vr-polish whats-new test-selection test-config",
    "test:full": "node scripts/test.mjs",
    "test:tap": "node scripts/test.mjs --test-reporter=tap",
    "test:junit": "node scripts/test.mjs --test-reporter=junit",
    "benchmark": "node scripts/benchmark.mjs",
    "example:headless": "node scripts/headless-enclosure.mjs",
    "benchmark:headless": "node scripts/benchmark-headless.mjs",
    "benchmark:composite": "node scripts/benchmark-composite.mjs",
    "benchmark:bake": "node scripts/benchmark-bake.mjs",
    "benchmark:shapes": "node scripts/benchmark-shapes.mjs",
    "benchmark:stamps": "node scripts/benchmark-stamps.mjs",
    "benchmark:surface-snap": "node scripts/benchmark-surface-snap.mjs",
    "benchmark:assembly": "node scripts/benchmark-assembly.mjs",
    "benchmark:arrays": "node scripts/benchmark-arrays.mjs",
    "test:changed": "node scripts/test.mjs --changed",
    "test:worker": "node scripts/test.mjs --worker persistent-move rotation-move move-worker move-precision",
    "benchmark:quality": "node scripts/benchmark-mesh-quality.mjs outputs/phase-3-quality-after.json",
    "benchmark:quality:move": "node scripts/benchmark-quality-move.mjs",
    "benchmark:recovery": "node scripts/benchmark-recovery.mjs",
    "stress:session": "node scripts/stress-session.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "check:types": "tsc --noEmit --strict",
    "check": "npm run format:check && npm run lint && npm run check:types && npm run build && npm run test:full",
    "example:enclosure": "node scripts/recipe-enclosure.mjs",
    "benchmark:enclosure": "node scripts/benchmark-enclosure.mjs",
    "dev:agent": "CENTRA_AGENT=1 vite --host 127.0.0.1",
    "mcp:agent": "node scripts/agent-mcp.mjs",
    "test:agent": "node scripts/test.mjs agent-access",
    "test:agent:browser": "node scripts/agent-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@iwer/devui": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.0",
    "@types/three": "^0.180.0",
    "fake-indexeddb": "^6.2.6",
    "iwer": "^2.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "zod": "^4.6.7"
  }
}
